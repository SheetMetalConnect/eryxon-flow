# Copy to .env. Only VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY are required.

# Local stack: run `npx supabase start` and paste the printed API URL and anon key.
# Hosted project: Settings -> API in the Supabase dashboard.
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Optional. Force self-hosted mode (one workshop, no plans); auto-detected otherwise.
# VITE_SELF_HOSTED=true

# Optional. Installable PWA shell (default: plain responsive web app).
VITE_ENABLE_PWA=false

# Optional. Where "Documentation" links point when you host your own docs.
# VITE_DOCS_URL="https://eryxon.eu"

# Optional. Client-side CAD mode; only with the matching Edge Function secrets configured.
# VITE_CAD_BACKEND_MODE="custom"

# Optional. Shown on the MCP setup page as the connection examples.
# VITE_MCP_HTTP_URL="http://localhost:3000/mcp"
# VITE_MCP_SERVER_ENTRYPOINT="/absolute/path/to/eryxon-flow/mcp-server/dist/index.js"

# Development only. Tenant that may reseed demo data from the dashboard.
# VITE_TEST_TENANT_ID=""
