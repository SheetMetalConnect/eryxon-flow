{
  "name": "eryxon-flow-mcp-server",
  "version": "3.0.1",
  "description": "MCP server for Eryxon Flow: production tools for AI agents over stdio or Streamable HTTP",
  "license": "BUSL-1.1",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "eryxon-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@supabase/supabase-js": "^2.100.1",
    "zod": "^4.3.6"
  },
  "overrides": {
    "ip-address": "^10.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
