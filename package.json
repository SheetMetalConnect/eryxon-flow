  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:api": "npx tsx scripts/api-test-utils.ts",
    "test:api:e2e": "bash scripts/test-api-e2e.sh",
    "drill:restore": "bash scripts/restore-drill.sh",
    "analyze": "vite build --mode analyze",
    "pwa:assets": "pwa-assets-generator --preset minimal-2023 public/pwa-icon.svg",
    "deps:graph": "madge --ts-config tsconfig.app.json --extensions ts,tsx --json src/App.tsx > docs/dependency-graph.json",
    "deps:circular": "madge --ts-config tsconfig.app.json --extensions ts,tsx --circular src/App.tsx",
    "screenshots:terminal": "node scripts/screenshots/capture-terminal.mjs",
    "test:edge": "deno test --allow-env --allow-read --config supabase/functions/deno.json supabase/functions/",
    "test:db": "bash scripts/test-db.sh",
    "test:release": "node --test scripts/deploy-image.test.mjs scripts/check-release.test.mjs scripts/check-pr-review.test.mjs scripts/docker-runtime-config.test.mjs",
    "pr:review": "node scripts/check-pr-review.mjs",
    "deploy:hosted": "bash scripts/deploy-hosted.sh",
    "typecheck:edge": "deno check --config supabase/functions/deno.json supabase/functions/*/index.ts"
  },
