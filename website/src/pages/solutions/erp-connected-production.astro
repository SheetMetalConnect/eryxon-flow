---
/*
 * Example campaign landing page (ERY-60, Slice 2) — `/solutions/erp-connected-production/`.
 *
 * Reference instance of the LandingPage template: one buyer problem (ERP/floor disconnect), one
 * primary CTA (hosted trial), one proof block, one secondary proof link into the API docs. Future
 * campaign/intent pages are created the same way — supply the props, fill the proof slot. This
 * proves the template is reusable without re-inventing the narrative hierarchy.
 */
import LandingPage from "@/layouts/LandingPage.astro";
import erpShot from "@/assets/overview.png";
---

<LandingPage
  title="ERP-connected production for job shops — Eryxon Flow"
  description="Connect ERP work orders to shop-floor execution. Eryxon Flow accepts production work over the REST API and emits signed webhooks as operations progress."
  slug="erp-connected-production"
  eyebrow="ERP-connected production"
  headline="Connect ERP work orders to shop-floor execution"
  intro="The ERP remains the system of record while Eryxon Flow handles execution at each production cell. Your integration creates jobs and routings through the REST API, then receives signed webhook events as work starts, changes and completes."
  primary={{ label: "Get started for free", href: "https://app.eryxon.eu", ctaId: "landing_erp_primary_hosted", kind: "hosted_app", external: true }}
  secondary={{ label: "See the REST API reference", href: "/api/rest-api-reference/", ctaId: "landing_erp_secondary_api", kind: "docs" }}
>
  <figure class="proof">
    <img src={erpShot.src} width={erpShot.width} height={erpShot.height} alt="Job and capacity overview board synced from the ERP" loading="lazy" />
    <figcaption>One board for production status across cells, fed by the ERP and updated from the floor.</figcaption>
  </figure>
  <ul class="points">
    <li><strong>Documented interfaces.</strong> Create jobs through the REST API and consume progress events through signed webhooks.</li>
    <li><strong>One execution record.</strong> Operators record work at the cell; connected systems can use that committed production state.</li>
    <li><strong>Source-available.</strong> Read and modify the source, and self-host the Community edition free for a single workshop.</li>
  </ul>
</LandingPage>

<style>
  .proof {
    margin: 0 0 var(--ery-space-8);
    border: 1px solid var(--ery-border);
    border-radius: var(--ery-radius);
    overflow: hidden;
    max-inline-size: 880px;
  }
  .proof img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    border-block-end: 1px solid var(--ery-border);
  }
  .proof figcaption {
    padding: var(--ery-space-4) var(--ery-space-5);
    font-size: var(--ery-text-sm);
    color: var(--ery-text-muted);
  }
  .points {
    margin: 0;
    padding-inline-start: var(--ery-space-5);
    display: flex;
    flex-direction: column;
    gap: var(--ery-space-3);
    max-inline-size: 62ch;
    color: var(--ery-text-muted);
  }
  .points strong {
    color: var(--ery-text);
  }
</style>
